{
  "schema_version": 1,
  "description": "Template only. A command reviewer reads the prompt on stdin and prints the review JSON. Agent CLIs may have tools and user memory; isolation_attested stays false unless you enforce and document isolation. {schema_path} is replaced by a temporary JSON Schema file.",
  "models": {
    "model_a": {
      "backend": "command",
      "argv": [
        "codex",
        "exec",
        "--ephemeral",
        "--skip-git-repo-check",
        "--ignore-user-config",
        "--sandbox",
        "read-only",
        "--color",
        "never",
        "--output-schema",
        "{schema_path}",
        "-"
      ],
      "version_argv": [
        "codex",
        "--version"
      ],
      "model_id": "REPLACE_WITH_THE_MODEL_YOUR_CODEX_CONFIG_USES",
      "timeout_seconds": 900
    },
    "model_b": {
      "backend": "ollama",
      "model": "REPLACE_WITH_AN_INSTALLED_OLLAMA_MODEL",
      "timeout_seconds": 900
    }
  }
}
