{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Review object",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "findings",
    "summary"
  ],
  "properties": {
    "verdict": {
      "enum": [
        "approve",
        "request_changes",
        "abstain"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding_id",
          "file",
          "line_start",
          "line_end",
          "severity",
          "description",
          "evidence"
        ],
        "properties": {
          "finding_id": {
            "type": "string",
            "minLength": 1
          },
          "file": {
            "const": "candidate.py"
          },
          "line_start": {
            "type": "integer",
            "minimum": 1
          },
          "line_end": {
            "type": "integer",
            "minimum": 1
          },
          "severity": {
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "verdict": {
            "const": "request_changes"
          }
        }
      },
      "then": {
        "properties": {
          "findings": {
            "minItems": 1
          }
        }
      },
      "else": {
        "properties": {
          "findings": {
            "maxItems": 0
          }
        }
      }
    }
  ]
}
